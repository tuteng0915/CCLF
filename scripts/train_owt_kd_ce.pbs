#!/bin/bash
# Idea 3+2: KD + cliff CE supervision.
# Uses train_owt_ELF-B-kd-ce.yml: adds L_ce_cliff on denoiser-mode samples,
# weighted by alpha_nm(t) = sigmoid(k*(t-0.30)) - sigmoid(k*(t-0.60)).
# Pushes lin_branch to classify correctly during the commitment cliff.
#
# Key env vars:
#   RESUME         — checkpoint to start from (default: official ELF-B-owt-torch)
#   OUTPUT_DIR     — where to write checkpoints
#   EPOCHS         — fine-tuning epochs (default 2)
#   NGPU           — GPUs to use (default 4)
#   TAG            — run label
#   WANDB_KEY      — WandB API key; set "" to disable
#   LAMBDA_KD      — KD loss weight (default 1.0)
#   LAMBDA_CE_CLIFF — cliff CE weight (default 0.5)
#
# Example:
#   qsub -v TAG=kd_ce scripts/train_owt_kd_ce.pbs
# Ablate CE weight:
#   qsub -v TAG=kd_ce_lam1,LAMBDA_CE_CLIFF=1.0 scripts/train_owt_kd_ce.pbs

#PBS -N elf_train_kd_ce
#PBS -P ds_ccds_wei.lu          # <-- update to your project code
#PBS -q gpu_ded
#PBS -l select=1:ncpus=48:ngpus=4
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

module purge
module load anaconda/2025
module load cuda/12.4
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate elf

REPO=/path/to/ELF-torch
cd "$REPO"
export PYTHONUNBUFFERED=1

if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi
echo "Job: ${PBS_JOBID}  Node: $(hostname)  GPU: ${CUDA_VISIBLE_DEVICES:-unset}"
nvidia-smi -L

# ── parameters ───────────────────────────────────────────────────────────────
TAG="${TAG:-kd_ce}"
RESUME="${RESUME:-embedded-language-flows/ELF-B-owt-torch}"
OUTPUT_DIR="${OUTPUT_DIR:-outputs/elf_b-owt-${TAG}}"
EPOCHS="${EPOCHS:-2}"
NGPU="${NGPU:-4}"
LAMBDA_KD="${LAMBDA_KD:-1.0}"
LAMBDA_CE_CLIFF="${LAMBDA_CE_CLIFF:-0.5}"
WANDB_KEY="${WANDB_KEY:-}"

mkdir -p pbs/logs

exec > "pbs/logs/train_${TAG}.${PBS_JOBID}.log" 2>&1

echo "Tag:              ${TAG}"
echo "Resume from:      ${RESUME}"
echo "Output dir:       ${OUTPUT_DIR}"
echo "Epochs:           ${EPOCHS}"
echo "NGPU:             ${NGPU}"
echo "lambda_kd:        ${LAMBDA_KD}"
echo "lambda_ce_cliff:  ${LAMBDA_CE_CLIFF}"

if [[ -n "${WANDB_KEY}" ]]; then
    wandb login "${WANDB_KEY}"
    USE_WANDB=true
else
    USE_WANDB=false
fi

NGPU=$NGPU bash scripts/launch.sh train \
    src/configs/training_configs/train_owt_ELF-B-kd-ce.yml \
    --config_override "resume=${RESUME}" \
    --config_override "output_dir=${OUTPUT_DIR}" \
    --config_override "epochs=${EPOCHS}" \
    --config_override "lambda_kd=${LAMBDA_KD}" \
    --config_override "lambda_ce_cliff=${LAMBDA_CE_CLIFF}" \
    --config_override "use_wandb=${USE_WANDB}" \
    --config_override "wandb_run_name=${TAG}"

echo "=== DONE ==="
